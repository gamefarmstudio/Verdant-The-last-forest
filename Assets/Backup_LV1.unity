      propertyPath: tutorialImages.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 4454183590977230711, guid: 92471ed66929cd746ab58f517621bca2,
        type: 3}
      propertyPath: 'tutorialSteps.Array.data[0]'
      value: 'THE GREEN DEFENSE | Welcome to Level 1, the Forest Glade! Our sacred
        forest is under threat from toxic waste. Use your starting Crystals to build
        your frontline defense right along the path.

'
      objectReference: {fileID: 0}
    - target: {fileID: 4454183590977230711, guid: 92471ed66929cd746ab58f517621bca2,
        type: 3}
      propertyPath: 'tutorialSteps.Array.data[1]'
      value: 'MELEE COMBAT: FOREST KNIGHT | A wave of Smog Goblins is approaching!
        Build a Forest Knight tower close to the path. This brave triple-target melee
        unit handles upfront incoming threats easily.

'
      objectReference: {fileID: 0}
    - target: {fileID: 4454183590977230711, guid: 92471ed66929cd746ab58f517621bca2,
        type: 3}
      propertyPath: 'tutorialSteps.Array.data[2]'
      value: 'RANGED COMBAT: GREENSHOT | Fast enemies are slipping through our lines!
        Deploy a Greenshot tower. This rapid-fire archer shoots distant single targets
        to back up your frontline knights.

'
      objectReference: {fileID: 0}
    - target: {fileID: 4454183590977230711, guid: 92471ed66929cd746ab58f517621bca2,
        type: 3}
      propertyPath: 'tutorialSteps.Array.data[3]'
      value: "THE THREAT OF PM 2.5 | These Smog Goblins carry dangerous air pollution
        that chokes the forest life. Keep an eye on your contamination levels\u2014if
        the pollution tracks too high, it is Game Over!\n"
      objectReference: {fileID: 0}
    - target: {fileID: 4454183590977230711, guid: 92471ed66929cd746ab58f517621bca2,
        type: 3}
      propertyPath: 'tutorialSteps.Array.data[4]'
      value: 
      objectReference: {fileID: 0}
