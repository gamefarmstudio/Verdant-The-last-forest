  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c3e757e2d127424418697c7f630eae63, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Tutorial
  tutorialSteps:
  - 'THE SUN DUNES SECTOR | Welcome to Level 3, the Sun Dunes. Resources are scarce
    on this long, winding desert path, and desertification has dried up the soil.
    Plan your spending carefully!

'
  - "ARMORED ENEMIES ARISING | Heavy threats have entered the dunes. Beware of Smog
    Brutes\u2014these massive armored enemies possess a 50% damage reduction filter.
    Your regular attacks will barely scratch them!\n"
  - 'UPGRADE FRONTLINES IMMEDIATELY | To break through industrial heavy armor, you
    must upgrade your Forest Knights to Level 3 to unlock Cleave area damage, or
    rely on upgraded high-tier units to melt their defense.

'
  - 'New tower: The Wildfire | To burn through enemy skin you must place the Wildfire.
    It uses fire to burn enemy skin. but it cost the most, So use them wisely!'
  - 'THE MICROPLASTIC CRISIS | Watch out for Hydra Goblins. When defeated, they instantly
    split into 2 smaller toxic threats, multiplying the contamination risk. Keep
    your Cleanse mechanics active or face a fast Game Over!

'
  - 'BOSS WAVE: THE PLASTIC QUEEN | Warning. Wave 15 is here and the Plastic Hydra
    Queen boss has arrived. She spawns 2 Hydra Goblins every 10 seconds, and spawns
    4 instead when her health drops below 50%. Focus all fire!

'
  tutorialHeaderTMPText: {fileID: 1962492889}
  tutorialBodyTMPText: {fileID: 140925531}
  tutorialImages:
  - {fileID: 1596308837}
  - {fileID: 381227535}
  - {fileID: 422998736}
